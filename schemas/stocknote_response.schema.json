{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stocknote_response.schema.json",
  "title": "stocknote analysis response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "analyses"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,63}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "analyses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "assessment", "confidence", "summary"],
        "properties": {
          "code": {"type": "string", "pattern": "^[0-9]{4}$"},
          "assessment": {"enum": ["positive", "neutral", "negative", "insufficient"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "summary": {"type": "string", "maxLength": 2000}
        }
      }
    }
  }
}
